# Copy this file to `.env.local` and fill in the values for your environment.

# Endpoint that receives trial-request form submissions.
# This points to the Neukod backend (a separate project), e.g. https://api.neukod.com
# Defaults to `/trials` (nginx-proxied) when not set.
NEXT_PUBLIC_TRIAL_ENDPOINT=

# Public site URL used in SEO / page metadata.
# Leave empty to fall back to the default value.
NEXT_PUBLIC_SITE_URL=
